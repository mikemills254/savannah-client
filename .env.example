# The API's full URL, prefix included, e.g. http://localhost:8000/api/v1. In dev
# the app calls /api/v1 on its own origin and Vite proxies it to this server, so
# the server needs no CORS_ORIGINS locally; a build calls this URL directly.
VITE_API_BASE_URL=

# Google sign-in: the OAuth web client id, the same value as the server's GOOGLE_CLIENT_ID.
# Add this site's origin to the client's "Authorized JavaScript origins". Leave empty to hide the button
VITE_GOOGLE_CLIENT_ID=
